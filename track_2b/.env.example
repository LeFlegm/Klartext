# Copy this file to .env and fill in your values. Never commit .env.

# OpenAI-compatible endpoint serving Apertus.
# Hackathon API during development; in an air-gapped deployment, the address of
# Apertus served on your own infrastructure (e.g. vLLM).
LLM_BASE_URL=https://hackapertus.livemap.sh/v1

# API key for that endpoint (leave a dummy value if your local server needs none).
LLM_API_KEY=your-api-key-here

# Default model for extraction.
LLM_NAME=apertus-v1.5-8b

# Larger model used by the cascade.
LLM_NAME_LARGE=apertus-v1.5-70b